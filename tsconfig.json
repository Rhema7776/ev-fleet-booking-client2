{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Vite handles the actual transpilation; tsc here is purely for
       type-checking (noEmit) — matches how Vite + TS projects normally work. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* allowJs + checkJs:false lets untouched .jsx files keep working
       unchanged while already-converted .tsx files get full type checking.
       This is what makes an incremental, page-by-page migration possible
       instead of an all-or-nothing rewrite. */
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
